{
  "compilerOptions": {
    "allowJs": true,
    "checkJs": true,
    "noEmit": true,
    "target": "es2024",
    "lib": ["es2024", "dom", "dom.iterable"],
    "module": "nodenext",
    "moduleResolution": "nodenext",
    "types": ["node"],
    "strict": false,
    "skipLibCheck": true
  },
  "include": ["main.js", "preload.js", "vault-store.js", "src/**/*.js", "src/**/*.d.ts"]
}
