<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
  <dict>
    <!-- V8 needs JIT pages under the hardened runtime. Nothing else is
         requested: no unsigned executable memory, no disabled library
         validation, no DYLD environment variables, no debugger attachment. -->
    <key>com.apple.security.cs.allow-jit</key>
    <true/>
  </dict>
</plist>
